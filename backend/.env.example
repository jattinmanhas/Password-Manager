APP_ENV=dev
APP_PORT=8080
APP_READ_TIMEOUT=10s
APP_WRITE_TIMEOUT=15s
APP_IDLE_TIMEOUT=60s

DATABASE_URL=postgres://pmv2:pmv2_dev_password@postgres:5432/pmv2?sslmode=disable
SESSION_TTL=720h
AUTH_TOKEN_PEPPER=pmv2-dev-pepper-change-me
TOTP_ISSUER=PMV2
FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=pmv2_session

# Number of trusted reverse proxies in front of the app (e.g. 1 behind Render).
# Used to read the real client IP from X-Forwarded-For. 0 = don't trust XFF.
TRUSTED_PROXY_COUNT=0

# Email (Resend) — sends password-reset and MFA-recovery codes.
# Leave RESEND_API_KEY empty in dev to LOG codes to the console instead of sending.
RESEND_API_KEY=
# Verified sender. In dev you can use Resend's sandbox: "PMV2 <onboarding@resend.dev>"
EMAIL_FROM=PMV2 <onboarding@resend.dev>
# Base URL of the web app (used in email copy).
APP_BASE_URL=http://localhost:5173

# Logging
# LOG_LEVEL: debug | info | warn | error  (default: info)
LOG_LEVEL=info
# LOG_FORMAT: text (human-readable) | json (structured, recommended for prod)
LOG_FORMAT=text
# Path to log file (relative to binary working directory)
LOG_FILE_PATH=logs/api.log
# Max size of a single log file in MB before it is rotated
LOG_MAX_SIZE_MB=100
# Max number of rotated backup files to keep
LOG_MAX_BACKUPS=10
# Delete rotated log files older than this many days (28 days retention)
LOG_MAX_AGE_DAYS=28
